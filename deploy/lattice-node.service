[Unit]
Description=Lattice hosted chain tree
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=lattice
Group=lattice
# The node exits 0 when asked to stop, 75 when asked to restart, 78 on a
# configuration that does not check: restart on failure, never on 78.
ExecStart=/usr/local/bin/lattice up --root /var/lib/lattice
Restart=on-failure
RestartPreventExitStatus=78
RestartSec=5
TimeoutStopSec=90
LimitNOFILE=65536
# Two malloc arenas: per-thread arenas hold freed boot peaks as resident memory.
Environment=MALLOC_ARENA_MAX=2

WorkingDirectory=/var/lib/lattice
StateDirectory=lattice
StateDirectoryMode=0750

StandardOutput=journal
StandardError=journal
SyslogIdentifier=lattice-node

[Install]
WantedBy=multi-user.target
